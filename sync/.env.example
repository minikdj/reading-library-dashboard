# Copy to sync/.env (git-ignored). Never commit the real file.

# Notion internal integration token (https://www.notion.so/my-integrations). The integration must be
# connected to the Books, Reads, Authors and Reading log databases (database page › ··· › Connections).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxx

# The Reading log data source id defaults to the one created 2026-10-16 (ced88101-…); override only if recreated.
# NOTION_LOG_DS=
# The Sync queue (questions for Dan + the run watermark) defaults to the one created 2026-10-17 by --init-queue (4e8f45b7-…).
# NOTION_QUEUE_DS=
# Dan's time zone: every date written to Notion is the event's date here (feed timestamps are Pacific).
# SYNC_TZ=America/New_York

# Goodreads numeric user id, from the profile URL goodreads.com/user/show/<id>-name.
GOODREADS_USER_ID=151183858
# Only if the Goodreads profile is private: the key= value from the RSS link Goodreads shows
# under "Recent updates" when signed in.
# GOODREADS_RSS_KEY=

# Books / Reads / Authors data source ids default to the runbook's; override only if they change.
# NOTION_BOOKS_DS=21e3da73-9608-41f8-a857-bd226043a391
# NOTION_READS_DS=05439130-377c-4e0b-948e-7c1d7ffb065e
# NOTION_AUTHORS_DS=f96682e9-8772-4493-abff-ec079148f1b2
