<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dan.reading-library.goodreads-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/djm/Projects/reading-library-dashboard/sync/goodreads_sync.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/djm/Projects/reading-library-dashboard</string>
  <!-- 23:45 every night. A run missed while the Mac was asleep fires at the next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/djm/Library/Logs/goodreads-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/djm/Library/Logs/goodreads-sync.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
